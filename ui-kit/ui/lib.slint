// Citrate Studio UI kit — the shared design-system surface. Consumers register
// this file as the `@citrate-ui-kit` Slint library (via build.rs) and import any
// symbol below. Single source of truth for theme, typography, icons, primitives.
export { Theme, Settings } from "theme.slint";
export { SelectableText, Label, Eyebrow, Title, Mono, Editorial } from "typography.slint";
export { AppIcon, CapGlyph } from "icons.slint";
export {
    Palettes, RiskDot, RiskBadge, DataChip, RoleGlyph, SurfBadge, SevDot,
    AnchorMark, Keyframe, Hairline, Btn, IconButton, Card,
} from "primitives.slint";
