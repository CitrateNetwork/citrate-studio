// =============================================================
// Citrate Studio — icon set (1.5px single-stroke, currentColor)
// Ported from primitives.jsx. Each icon is one Path on a 24×24
// viewbox; circles/rects are expressed as arc/line subpaths so the
// whole set is a single element driven by `name`. Stroke width
// scales with size to keep the optical 1.5/24 ratio of the web kit.
// =============================================================
import { Theme } from "theme.slint";

export component AppIcon inherits Rectangle {
    in property <string> name;
    in property <length> size: 16px;
    in property <float> stroke-weight: 1.5;
    in property <brush> tint: Theme.fg-1;
    width: size;
    height: size;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.tint;
        stroke-width: root.size / 24 * root.stroke-weight;
        stroke-line-cap: round;
        commands:
              root.name == "play" ? "M7 4 L19 12 L7 20 Z"
            : root.name == "pause" ? "M6 4 H10 V20 H6 Z M14 4 H18 V20 H14 Z"
            : root.name == "step" ? "M6 4 L15 12 L6 20 Z M18 4 V20"
            : root.name == "stepback" ? "M18 4 L9 12 L18 20 Z M6 4 V20"
            : root.name == "rewind" ? "M19 5 L5 12 L19 19 Z"
            : root.name == "layers" ? "M12 3 L21 8 L12 13 L3 8 Z M3 13 L12 18 L21 13"
            : root.name == "eye" ? "M2 12 C4 8 7.5 5 12 5 C16.5 5 20 8 22 12 C20 16 16.5 19 12 19 C7.5 19 4 16 2 12 Z M9.5 12 A2.5 2.5 0 1 0 14.5 12 A2.5 2.5 0 1 0 9.5 12 Z"
            : root.name == "eyeoff" ? "M4 4 L20 20 M9.5 9.6 A2.5 2.5 0 0 0 14.4 14.5 M6.5 6.7 C4 8.3 2 12 2 12 C4 16 8 19 12 19 C13.7 19 15.2 18.6 16.5 17.9 M9.8 5.2 C10.5 5.1 11.2 5 12 5 C18 5 22 12 22 12 C21.4 13 20.7 13.9 19.8 14.8"
            : root.name == "solo" ? "M8 12 A4 4 0 1 0 16 12 A4 4 0 1 0 8 12 Z"
            : root.name == "lock" ? "M5 11 H19 V20 H5 Z M8 11 V8 A4 4 0 0 1 16 8 V11"
            : root.name == "search" ? "M4 10 A6 6 0 1 0 16 10 A6 6 0 1 0 4 10 Z M15 15 L21 21"
            : root.name == "plus" ? "M12 4 V20 M4 12 H20"
            : root.name == "x" ? "M6 6 L18 18 M18 6 L6 18"
            : root.name == "check" ? "M5 12 L10 17 L19 8"
            : root.name == "chevright" ? "M9 6 L15 12 L9 18"
            : root.name == "chevdown" ? "M6 9 L12 15 L18 9"
            : root.name == "chevup" ? "M6 15 L12 9 L18 15"
            : root.name == "bell" ? "M18 16 V11 A6 6 0 0 0 6 11 V16 L4 18 H20 L18 16 Z M10 21 A2 2 0 0 0 14 21"
            : root.name == "settings" ? "M9 12 A3 3 0 1 0 15 12 A3 3 0 1 0 9 12 Z M12 2 V5 M12 19 V22 M2 12 H5 M19 12 H22 M5 5 L7 7 M17 17 L19 19 M19 5 L17 7 M7 17 L5 19"
            : root.name == "alert" ? "M12 3 L22 20 H2 Z M12 9 V14 M12 17 V17.5"
            : root.name == "shield" ? "M12 2 L20 6 V12 C20 17 16 21 12 22 C8 21 4 17 4 12 V6 Z"
            : root.name == "gavel" ? "M3 21 H13 M7 17 L14 10 M11 4 L18 11 M9 6 L16 13"
            : root.name == "anchor" ? "M9.5 5 A2.5 2.5 0 1 0 14.5 5 A2.5 2.5 0 1 0 9.5 5 Z M12 7.5 V20 M5 13 A7 7 0 0 0 19 13 M5 13 H8 M19 13 H16"
            : root.name == "heart" ? "M12 21 C12 21 4 14 4 9 A4.5 4.5 0 0 1 12 6 A4.5 4.5 0 0 1 20 9 C20 14 12 21 12 21 Z"
            : root.name == "file" ? "M14 3 H6 V21 H18 V7 Z M14 3 V7 H18"
            : root.name == "code" ? "M9 8 L5 12 L9 16 M15 8 L19 12 L15 16"
            : root.name == "download" ? "M12 4 V15 M7 11 L12 16 L17 11 M5 20 H19"
            : root.name == "clock" ? "M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 Z M12 7 V12 L15 14"
            : root.name == "spark" ? "M12 3 L13.8 9.5 L20 12 L13.8 14.5 L12 21 L10.2 14.5 L4 12 L10.2 9.5 Z"
            : root.name == "arrowdown" ? "M12 4 V20 M6 14 L12 20 L18 14"
            : root.name == "arrow" ? "M5 12 H19 M13 6 L19 12 L13 18"
            : root.name == "send" ? "M4 12 L20 4 L14 20 L11 13 Z"
            : root.name == "chat" ? "M4 5 H20 V16 H9 L4 20 Z"
            : root.name == "user" ? "M8 8 A4 4 0 1 0 16 8 A4 4 0 1 0 8 8 Z M4 21 A8 8 0 0 1 20 21"
            : root.name == "users" ? "M5.6 8 A3.4 3.4 0 1 0 12.4 8 A3.4 3.4 0 1 0 5.6 8 Z M3 20 A6 6 0 0 1 15 20 M16 5 A3.2 3.2 0 0 1 16 11.2 M16.5 14 A6 6 0 0 1 21 20"
            : root.name == "building" ? "M5 3 H19 V21 H5 Z M9 7 H11 M13 7 H15 M9 11 H11 M13 11 H15 M9 15 H11 M13 15 H15"
            : root.name == "key" ? "M4 12 A4 4 0 1 0 12 12 A4 4 0 1 0 4 12 Z M11 12 H21 M18 12 V15 M15 12 V15"
            : root.name == "sliders" ? "M4 8 H14 M18 8 H20 M4 16 H8 M12 16 H20 M16 6 V10 M10 14 V18"
            : root.name == "logout" ? "M14 4 H6 V20 H14 M10 12 H21 M17 8 L21 12 L17 16"
            : root.name == "refresh" ? "M20 11 A8 8 0 1 0 18 17 M20 5 V11 H14"
            : root.name == "dots" ? "M3.6 12 A1.4 1.4 0 1 0 6.4 12 A1.4 1.4 0 1 0 3.6 12 Z M10.6 12 A1.4 1.4 0 1 0 13.4 12 A1.4 1.4 0 1 0 10.6 12 Z M17.6 12 A1.4 1.4 0 1 0 20.4 12 A1.4 1.4 0 1 0 17.6 12 Z"
            : root.name == "extlink" ? "M14 5 H19 V10 M19 5 L11 13 M18 14 V19 H5 V6 H10"
            : root.name == "grip" ? "M8 6 A1 1 0 1 0 10 6 A1 1 0 1 0 8 6 Z M8 12 A1 1 0 1 0 10 12 A1 1 0 1 0 8 12 Z M8 18 A1 1 0 1 0 10 18 A1 1 0 1 0 8 18 Z M14 6 A1 1 0 1 0 16 6 A1 1 0 1 0 14 6 Z M14 12 A1 1 0 1 0 16 12 A1 1 0 1 0 14 12 Z M14 18 A1 1 0 1 0 16 18 A1 1 0 1 0 14 18 Z"
            : root.name == "schedule" ? "M5 13 A7 7 0 1 0 19 13 A7 7 0 1 0 5 13 Z M12 10 V13 L14 15 M9 3 H15 M12 3 V6"
            : root.name == "home" ? "M4 11 L12 4 L20 11 M6 10 V20 H18 V10"
            : "";
    }
}

// ---- capability glyph (CapabilityToken) ----
// net | fs | read | write | cli | clocks | random
export component CapGlyph inherits Rectangle {
    in property <string> cap;
    in property <length> size: 16px;
    in property <brush> tint: Theme.fg-3;
    width: size;
    height: size;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.tint;
        stroke-width: root.size / 24 * 1.5;
        stroke-line-cap: round;
        commands:
              root.cap == "net" ? "M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 Z M3 12 H21 M12 3 C16 7 16 17 12 21 C8 17 8 7 12 3"
            : root.cap == "fs" ? "M3 7 A1 1 0 0 1 4 6 H9 L11 8 H19 A1 1 0 0 1 20 9 V18 A1 1 0 0 1 19 19 H4 A1 1 0 0 1 3 18 Z"
            : root.cap == "read" ? "M5 11 A6 6 0 1 0 17 11 A6 6 0 1 0 5 11 Z M15.5 15.5 L20 20 M8.5 11 H13.5"
            : root.cap == "write" ? "M4 20 L4 16 L15 5 L19 9 L8 20 Z M13 7 L17 11"
            : root.cap == "cli" ? "M3 4 H21 V20 H3 Z M7 9 L10 12 L7 15 M13 15 H17"
            : root.cap == "clocks" ? "M4 12 A8 8 0 1 0 20 12 A8 8 0 1 0 4 12 Z M12 8 V12 L15 13.5"
            : root.cap == "random" ? "M4 4 H20 V20 H4 Z"
            : "";
    }
    // die pips for the random/entropy glyph (filled)
    if root.cap == "random": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        stroke: transparent;
        commands: "M7.9 9 A1.1 1.1 0 1 0 10.1 9 A1.1 1.1 0 1 0 7.9 9 Z M13.9 15 A1.1 1.1 0 1 0 16.1 15 A1.1 1.1 0 1 0 13.9 15 Z M13.9 9 A1.1 1.1 0 1 0 16.1 9 A1.1 1.1 0 1 0 13.9 9 Z M7.9 15 A1.1 1.1 0 1 0 10.1 15 A1.1 1.1 0 1 0 7.9 15 Z";
    }
}
