// =============================================================
// Citrate Studio — Capsule Palette (the tool bin)
// 17 native tools + signed .cps capsules. Unsigned / hash-mismatched
// tiles render dimmed + locked (capsule_body_verified fail-closed):
// the UI refuses to stage what the core would refuse to run.
// =============================================================
import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { AppIcon, CapGlyph } from "../icons.slint";
import { RiskDot, DataChip, SurfBadge, Btn, Palettes } from "../primitives.slint";
import { Eyebrow, Label } from "../typography.slint";
import { AppState, ToolData, CapsuleData } from "../models.slint";

component GroupLabel inherits Text {
    font-family: Theme.font-mono;
    font-size: 9px;
    letter-spacing: 1.3px;
    color: Theme.fg-3;
}

component ToolTile inherits Rectangle {
    in property <ToolData> t;
    height: 48px;
    border-radius: Theme.r-1;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.ink : Theme.border-1;
    background: Theme.paper-pure;
    drop-shadow-color: touch.has-hover ? Theme.shadow-soft : transparent;
    drop-shadow-blur: touch.has-hover ? 4px : 0;
    animate border-color { duration: Theme.dur-fast; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 9px;
        RiskDot { tier: root.t.risk; y: (parent.height - self.height) / 2; }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text {
                text: root.t.name;
                font-family: Theme.font-mono;
                font-size: 12px;
                font-weight: 500;
                color: Theme.ink;
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                CapGlyph { cap: root.t.cap; size: 13px; tint: root.t.cap == "write" ? Theme.danger : Theme.ink; y: (parent.height - self.height)/2; }
                Text {
                    text: root.t.nature;
                    font-family: Theme.font-mono;
                    font-size: 9.5px;
                    letter-spacing: 0.2px;
                    color: Theme.fg-3;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.t.risk == "critical": AppIcon { name: "alert"; size: 13px; tint: Theme.danger; y: (parent.height - self.height)/2; }
    }
    touch := TouchArea { mouse-cursor: grab; }
}

component CapsuleTile inherits Rectangle {
    in property <CapsuleData> t;
    property <bool> locked: !t.verified;
    height: 48px;
    border-radius: Theme.r-1;
    border-width: 1px;
    border-color: locked ? Theme.border-2 : (touch.has-hover ? Theme.ink : Theme.border-1);
    background: locked ? Theme.stone-50 : Theme.paper-pure;
    opacity: locked ? 0.62 : 1.0;
    drop-shadow-color: (!locked && touch.has-hover) ? Theme.shadow-soft : transparent;
    drop-shadow-blur: (!locked && touch.has-hover) ? 4px : 0;
    animate border-color { duration: Theme.dur-fast; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 9px;
        RiskDot { tier: root.t.risk; y: (parent.height - self.height) / 2; }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            HorizontalLayout {
                spacing: 5px;
                alignment: start;
                Text { text: root.t.name; font-family: Theme.font-mono; font-size: 12px; font-weight: 500; color: Theme.ink; }
                Text { text: root.t.version; font-family: Theme.font-mono; font-size: 12px; color: Theme.fg-3; }
            }
            HorizontalLayout {
                spacing: 5px;
                alignment: start;
                for c in root.t.caps: CapGlyph { cap: c; size: 13px; tint: c == "write" ? Theme.danger : Theme.ink; y: (parent.height - self.height)/2; }
                if root.t.dc != "": DataChip { cls: root.t.dc; y: (parent.height - self.height)/2; }
                SurfBadge { surface: root.t.signing; y: (parent.height - self.height)/2; }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.locked: AppIcon { name: "lock"; size: 13px; tint: Theme.fg-3; y: (parent.height - self.height)/2; }
    }
    touch := TouchArea {
        mouse-cursor: root.locked ? not-allowed : grab;
        clicked => { if (!root.locked) { AppState.select-by-name(root.t.name); } }
    }
}

export component CapsulePalette inherits Rectangle {
    background: Theme.paper-2;
    VerticalLayout {
        // head
        Rectangle {
            background: Theme.paper-2;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                HorizontalLayout {
                    Eyebrow { text: "CAPSULE PALETTE"; color: Theme.fg-2; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Btn { text: "Build"; icon: "plus"; kind: "ghost"; sm: true; clicked => { AppState.open-code("recon.match-phi"); } }
                }
                // search
                Rectangle {
                    height: 30px;
                    border-radius: Theme.r-1;
                    border-width: 1px;
                    border-color: search-input.has-focus ? Theme.ink : Theme.border-2;
                    background: Theme.paper-pure;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        AppIcon { name: "search"; size: 14px; tint: Theme.fg-3; y: (parent.height - self.height)/2; }
                        search-input := TextInput {
                            text: AppState.palette-search;
                            font-family: Theme.font-sans;
                            font-size: 12px;
                            color: Theme.ink;
                            vertical-alignment: center;
                            single-line: true;
                            edited => { AppState.set-search(self.text); }
                        }
                    }
                    // placeholder
                    if AppState.palette-search == "" && !search-input.has-focus: Text {
                        text: "Search · risk · capability · class";
                        x: 28px;
                        color: Theme.fg-3;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border-1; }
        // body
        ScrollView {
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                alignment: start;
                GroupLabel { text: "INSTALLED CAPSULES · .CPS"; }
                for c in AppState.capsules: CapsuleTile { t: c; }
                GroupLabel { text: "CHAIN TOOLS · AGENT-CHAIN"; }
                for t in AppState.tools-chain: ToolTile { t: t; }
                GroupLabel { text: "CODE TOOLS · AGENT-CODE"; }
                for t in AppState.tools-code: ToolTile { t: t; }
            }
        }
    }
}
