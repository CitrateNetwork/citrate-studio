// =============================================================
// Citrate Studio — Agent chat (the real L0)
// Shared by the Beginner workspace, the Advanced chat drawer, and
// the onboarding flow. The agent never claims to bypass approvals —
// it submits intents; the core decides. Inline HITL approval is the
// trust instrument, rendered right in the conversation.
// =============================================================
import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { AppIcon } from "../icons.slint";
import { RiskBadge, RiskDot, DataChip, RoleGlyph, Btn, IconButton, SurfBadge, Palettes } from "../primitives.slint";
import { Eyebrow, SelectableText, Editorial } from "../typography.slint";
import { AppState, ChatMsg, CardStep, ApprovalRow } from "../models.slint";

// ---- a message bubble ----
component Bubble inherits Rectangle {
    in property <ChatMsg> m;
    property <bool> agent: m.kind == "agent";
    HorizontalLayout {
        padding-left: 0; padding-right: 0;
        Rectangle { width: root.agent ? 0px : 1px; horizontal-stretch: root.agent ? 0 : 1; }
        HorizontalLayout {
            spacing: 9px;
            alignment: root.agent ? start : end;
            horizontal-stretch: root.agent ? 1 : 0;
            if root.agent: Rectangle {
                width: 26px; height: 26px; border-radius: 13px; background: Theme.citrate-green;
                AppIcon { name: "spark"; size: 14px; tint: Theme.ink; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
            }
            Rectangle {
                background: root.agent ? Theme.paper-pure : Theme.ink;
                border-width: 1px;
                border-color: root.agent ? Theme.border-1 : Theme.ink;
                border-radius: 12px;
                border-top-left-radius: root.agent ? 3px : 12px;
                border-top-right-radius: root.agent ? 12px : 3px;
                max-width: 360px;
                bub := VerticalLayout {
                    padding: 9px;
                    padding-left: 12px;
                    padding-right: 12px;
                    SelectableText {
                        text: root.m.text;
                        wrap: word-wrap; single-line: false;
                        font-size: 13.5px;
                        color: root.agent ? Theme.fg-1 : Theme.paper;
                        width: min(336px, self.preferred-width);
                    }
                }
                height: bub.preferred-height;
            }
        }
        Rectangle { width: root.agent ? 1px : 0px; horizontal-stretch: root.agent ? 1 : 0; }
    }
}

// ---- inline outcome card (run results) ----
component ChatOutcome inherits Rectangle {
    in property <ChatMsg> m;
    height: card.preferred-height;
    border-width: 1px; border-color: Theme.border-2; border-radius: Theme.r-2;
    background: Theme.paper-pure;
    drop-shadow-color: #00000014; drop-shadow-blur: 2px;
    card := VerticalLayout {
        Rectangle {
            height: 36px;
            background: Theme.paper-2;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; spacing: 8px;
                AppIcon { name: "check"; size: 14px; stroke-weight: 2; tint: Theme.citrate-green-deep; y: (parent.height - self.height)/2; }
                Eyebrow { text: root.m.card-title; color: Theme.fg-2; vertical-alignment: center; horizontal-stretch: 1; }
                Rectangle {
                    border-radius: Theme.r-pill; background: Theme.risk-low-tint; y: (parent.height - self.height)/2;
                    HorizontalLayout { padding-left: 6px; padding-right: 6px; padding-top: 2px; padding-bottom: 2px;
                        Text { text: "ON RECORD"; font-family: Theme.font-mono; font-size: 8px; font-weight: 600; letter-spacing: 0.6px; color: Theme.risk-low-deep; }
                    }
                }
            }
        }
        VerticalLayout {
            padding: 12px;
            spacing: 7px;
            for s in root.m.steps: HorizontalLayout {
                spacing: 8px;
                RiskDot { tier: s.risk; y: (parent.height - self.height)/2; }
                SelectableText { text: s.name; font-family: Theme.font-mono; font-size: 11.5px; color: Theme.fg-2; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: s.note; font-size: 11px; color: Theme.fg-3; vertical-alignment: center; }
            }
        }
        if root.m.cta != "": Rectangle {
            height: 44px;
            Btn {
                text: root.m.cta; icon: "layers"; kind: "ghost";
                x: 12px; y: 0; width: parent.width - 24px;
                clicked => { AppState.open-advanced-run(); }
            }
        }
    }
}

// ---- inline HITL approval (drives the global gate) ----
component ChatApprovalSlot inherits Rectangle {
    in property <ApprovalRow> slot;
    height: 40px;
    border-radius: Theme.r-1;
    border-width: 1px;
    border-color: slot.signed ? Theme.citrate-green-deep : Theme.border-1;
    background: slot.signed ? Theme.citrate-green-tint : Theme.paper-2;
    opacity: (slot.disabled && !slot.signed) ? 0.55 : 1.0;
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 8px;
        RoleGlyph { role: root.slot.role; size: 20px; y: (parent.height - self.height)/2; }
        VerticalLayout {
            alignment: center; spacing: 0px; horizontal-stretch: 1;
            Text { text: root.slot.role; font-size: 12px; font-weight: 500; color: Theme.ink; }
            Text { text: root.slot.name; font-family: Theme.font-mono; font-size: 9px; color: Theme.fg-3; }
        }
        if root.slot.signed: AppIcon { name: "check"; size: 15px; stroke-weight: 2; tint: Theme.citrate-green-deep; y: (parent.height - self.height)/2; }
        if !root.slot.signed && root.slot.disabled: Text { text: root.slot.reason; font-family: Theme.font-mono; font-size: 9px; color: Theme.fg-3; vertical-alignment: center; }
        if !root.slot.signed && !root.slot.disabled: Rectangle {
            border-radius: Theme.r-1; background: Theme.ink; y: (parent.height - self.height)/2;
            HorizontalLayout { padding-left: 10px; padding-right: 10px; padding-top: 4px; padding-bottom: 4px;
                Text { text: "Sign"; color: Theme.paper; font-size: 11px; font-weight: 500; vertical-alignment: center; }
            }
            TouchArea { mouse-cursor: pointer; clicked => { AppState.sign(root.slot.role); } }
        }
    }
}

component ChatApproval inherits Rectangle {
    height: body.preferred-height;
    border-radius: Theme.r-2;
    border-width: 1px; border-color: Theme.risk-high;
    background: Theme.paper-pure;
    body := VerticalLayout {
        Rectangle {
            height: 38px;
            background: Theme.risk-high-tint;
            HorizontalLayout {
                padding-left: 13px; padding-right: 13px; spacing: 8px;
                AppIcon { name: "gavel"; size: 14px; tint: Theme.risk-high-deep; y: (parent.height - self.height)/2; }
                RiskBadge { tier: "high"; y: (parent.height - self.height)/2; }
                Text { text: "2-of-" + AppState.pending-clip.quorum-roles.length + " · your sign-off needed"; font-family: Theme.font-mono; font-size: 10px; color: Theme.risk-high-deep; vertical-alignment: center; }
            }
        }
        VerticalLayout {
            padding: 13px;
            spacing: 9px;
            Text { text: AppState.pending-clip.name; font-family: Theme.font-mono; font-size: 12.5px; font-weight: 500; color: Theme.ink; }
            SelectableText { text: AppState.pending-clip.purpose; wrap: word-wrap; single-line: false; font-size: 12px; color: Theme.fg-2; width: 100%; }
            HorizontalLayout { spacing: 5px; alignment: start; for d in AppState.pending-clip.reads: DataChip { cls: d; } }
            // hash pin
            Rectangle {
                border-radius: Theme.r-1; border-width: 1px; border-color: Theme.border-1; background: Theme.stone-50;
                HorizontalLayout {
                    padding: 8px; spacing: 7px;
                    AppIcon { name: "shield"; size: 13px; tint: Theme.fg-2; y: (parent.height - self.height)/2; }
                    SelectableText { text: "Covers exactly these bytes — if the request changes, this voids. " + AppState.pending-clip.payload-hash; wrap: word-wrap; single-line: false; font-size: 10.5px; color: Theme.fg-2; horizontal-stretch: 1; }
                }
            }
            for r in AppState.approval-roster: ChatApprovalSlot { slot: r; }
            if AppState.quorum-met: Btn { text: "Approve & continue"; icon: "check"; kind: "primary"; clicked => { AppState.chat-approve(); } }
            if !AppState.quorum-met: Text { text: AppState.signatures.length + "/" + AppState.pending-clip.quorum-n + " signatures · core decides"; font-family: Theme.font-mono; font-size: 10.5px; color: Theme.fg-3; }
        }
    }
}

component TypingDots inherits HorizontalLayout {
    spacing: 9px;
    Rectangle { width: 26px; height: 26px; border-radius: 13px; background: Theme.citrate-green;
        AppIcon { name: "spark"; size: 14px; tint: Theme.ink; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
    }
    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        for d in 3: Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.stone-400; y: (parent.height - self.height)/2; }
    }
}

// ---- the reusable chat panel ----
export component ChatPanel inherits Rectangle {
    in property <[ChatMsg]> messages;
    in property <[string]> quick;
    in property <bool> busy;
    in property <string> placeholder: "Tell the agent the outcome you want…";
    callback send(string);
    callback chip(string);

    VerticalLayout {
        // messages
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                alignment: start;
                for m in root.messages: Rectangle {
                    height: inner.preferred-height;
                    inner := VerticalLayout {
                        if m.kind == "agent" || m.kind == "user": Bubble { m: m; }
                        if m.kind == "card": HorizontalLayout { padding-left: 35px; ChatOutcome { m: m; } }
                        if m.kind == "approval": HorizontalLayout { padding-left: 35px; ChatApproval { } }
                    }
                }
                if root.busy: TypingDots { }
            }
        }
        // quick replies
        if root.quick.length > 0: Rectangle {
            height: chips.preferred-height + 12px;
            chips := HorizontalLayout {
                x: 16px; y: 0;
                width: parent.width - 32px;
                spacing: 7px;
                alignment: start;
                for c in root.quick: Rectangle {
                    border-radius: Theme.r-pill;
                    border-width: 1px; border-color: Theme.citrate-green-deep;
                    background: Theme.citrate-green-tint;
                    horizontal-stretch: 0;
                    HorizontalLayout {
                        padding-left: 11px; padding-right: 11px; padding-top: 6px; padding-bottom: 6px;
                        Text { text: c; font-size: 12.5px; font-weight: 500; color: Theme.citrate-green-dark; vertical-alignment: center; }
                    }
                    TouchArea { mouse-cursor: pointer; clicked => { root.chip(c); } }
                }
            }
        }
        // composer
        Rectangle {
            height: 64px;
            background: Theme.paper-2;
            Rectangle { x: 0; y: 0; width: 100%; height: 1px; background: Theme.border-1; }
            HorizontalLayout {
                padding: 12px;
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Theme.r-1; border-width: 1px;
                    border-color: input.has-focus ? Theme.ink : Theme.border-2;
                    background: Theme.paper-pure;
                    input := TextInput {
                        x: 12px; width: parent.width - 24px;
                        vertical-alignment: center;
                        font-size: 13.5px; color: Theme.ink;
                        single-line: true;
                        accepted => { if (self.text != "") { root.send(self.text); self.text = ""; } }
                    }
                    if input.text == "" && !input.has-focus: Text { x: 12px; text: root.placeholder; color: Theme.fg-3; font-size: 13.5px; vertical-alignment: center; }
                }
                Btn { icon: "arrow"; kind: "primary"; clicked => { if (input.text != "") { root.send(input.text); input.text = ""; } } }
            }
        }
    }
}

// ---- Beginner workspace ----
export component BeginnerView inherits Rectangle {
    background: Theme.paper;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 720px;
            background: Theme.paper-2;
            border-width: 1px; border-color: Theme.border-1;
            VerticalLayout {
                Rectangle {
                    height: 56px;
                    background: Theme.paper-2;
                    Rectangle { x: 0; y: parent.height - 1px; width: 100%; height: 1px; background: Theme.border-1; }
                    HorizontalLayout {
                        padding-left: 18px; padding-right: 18px; spacing: 10px;
                        Rectangle { width: 28px; height: 28px; border-radius: 14px; background: Theme.citrate-green; y: (parent.height - self.height)/2;
                            AppIcon { name: "spark"; size: 15px; tint: Theme.ink; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                        }
                        VerticalLayout {
                            alignment: center; spacing: 1px; horizontal-stretch: 1;
                            Text { text: "Citrate agent"; font-family: Theme.font-display; font-weight: 500; font-size: 15px; color: Theme.ink; }
                            Text { text: "on-prem · everything on the record"; font-family: Theme.font-mono; font-size: 10px; color: Theme.fg-3; }
                        }
                        Btn { text: "Setup"; icon: "schedule"; kind: "ghost"; sm: true; clicked => { AppState.start-onboarding(); } }
                        Btn { text: "Open Studio"; icon: "layers"; kind: "ghost"; sm: true; clicked => { AppState.set-workspace("advanced"); } }
                    }
                }
                ChatPanel {
                    messages: AppState.chat-messages;
                    quick: AppState.chat-quick;
                    busy: AppState.chat-busy;
                    send(t) => { AppState.chat-send(t); }
                    chip(c) => { AppState.chat-chip(c); }
                }
            }
        }
    }
}

// ---- Advanced chat drawer (right slide-in) ----
export component ChatDrawer inherits Rectangle {
    background: #0c221655;
    TouchArea { clicked => { AppState.chat-open = false; } }
    Rectangle {
        x: parent.width - self.width;
        width: 384px;
        background: Theme.paper-2;
        border-width: 1px; border-color: Theme.border-2;
        TouchArea { }
        VerticalLayout {
            Rectangle {
                height: 52px;
                background: Theme.sealed-bg-2;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; spacing: 9px;
                    Rectangle { width: 26px; height: 26px; border-radius: 13px; background: Theme.citrate-green; y: (parent.height - self.height)/2;
                        AppIcon { name: "spark"; size: 14px; tint: Theme.ink; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                    }
                    VerticalLayout {
                        alignment: center; spacing: 1px; horizontal-stretch: 1;
                        Text { text: "Agent"; font-family: Theme.font-display; font-weight: 500; font-size: 14px; color: #ffffff; }
                        Text { text: "L0 · the real chat"; font-family: Theme.font-mono; font-size: 9.5px; color: Theme.sealed-fg-3; }
                    }
                    IconButton { icon: "x"; tint: Theme.sealed-fg-2; on-dark: true; clicked => { AppState.chat-open = false; } }
                }
            }
            ChatPanel {
                messages: AppState.chat-messages;
                quick: AppState.chat-quick;
                busy: AppState.chat-busy;
                placeholder: "Ask about this run, or what to do next…";
                send(t) => { AppState.chat-send(t); }
                chip(c) => { AppState.chat-chip(c); }
            }
        }
    }
}
