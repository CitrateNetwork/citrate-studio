// =============================================================
// Citrate Studio — UI-kit primitives
// Risk-tier system, data-class chips, role glyphs, signing-surface
// badges, anchor marks, severity dots, keyframe diamonds, buttons,
// cards, hairlines. 1:1 with studio.css. Every consequential signal
// in the product is one of these.
// =============================================================
import { Theme } from "theme.slint";
import { AppIcon } from "icons.slint";
import { Label, Eyebrow } from "typography.slint";

// ---- color helpers (keeps components declarative, no repeated ternaries) ----
export global Palettes {
    pure public function risk-base(t: string) -> color {
        t == "low" ? Theme.risk-low : t == "medium" ? Theme.risk-medium
        : t == "high" ? Theme.risk-high : t == "critical" ? Theme.risk-critical
        : Theme.stone-300
    }
    pure public function risk-deep(t: string) -> color {
        t == "low" ? Theme.risk-low-deep : t == "medium" ? Theme.risk-medium-deep
        : t == "high" ? Theme.risk-high-deep : t == "critical" ? Theme.risk-critical-deep
        : Theme.fg-2
    }
    pure public function risk-tint(t: string) -> color {
        t == "low" ? Theme.risk-low-tint : t == "medium" ? Theme.risk-medium-tint
        : t == "high" ? Theme.risk-high-tint : t == "critical" ? Theme.risk-critical-tint
        : Theme.stone-100
    }
    pure public function risk-up(t: string) -> string {
        t == "low" ? "LOW" : t == "medium" ? "MEDIUM" : t == "high" ? "HIGH" : t == "critical" ? "CRITICAL" : t
    }
    // data-class → {fg, border, bg}; key is first segment lowercased by caller
    pure public function dc-fg(k: string) -> color {
        k == "cui" ? Theme.info : k == "phi" ? #6d3b8e : k == "ferpa" ? Theme.warning
        : k == "itar" ? #ffffff : Theme.fg-2
    }
    pure public function dc-border(k: string) -> color {
        k == "cui" ? Theme.info : k == "phi" ? #6d3b8e : k == "ferpa" ? Theme.warning
        : k == "itar" ? Theme.danger : Theme.border-2
    }
    pure public function dc-bg(k: string) -> color {
        k == "cui" ? Theme.info-bg : k == "phi" ? #efe6f4 : k == "ferpa" ? Theme.warning-bg
        : k == "itar" ? Theme.danger : Theme.paper-2
    }
    pure public function sev-color(s: string) -> color {
        (s == "Pass" || s == "pass") ? Theme.citrate-green
        : (s == "Warn" || s == "warn") ? Theme.citrate-yellow
        : (s == "Blocker" || s == "blocker") ? Theme.danger : Theme.stone-300
    }
    pure public function role-abbr(r: string) -> string {
        r == "Operator" ? "OP" : r == "Reviewer" ? "RV" : r == "ComplianceOfficer" ? "CO"
        : r == "SecurityOfficer" ? "SO" : r == "Auditor" ? "AU" : "··"
    }
}

// ---- risk dot ----
export component RiskDot inherits Rectangle {
    in property <string> tier;
    in property <length> size: 8px;
    width: size;
    height: size;
    border-radius: size / 2;
    background: Palettes.risk-base(tier);
}

// ---- risk badge (pill) ----
export component RiskBadge inherits Rectangle {
    in property <string> tier;
    border-radius: Theme.r-pill;
    background: Palettes.risk-tint(tier);
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 5px;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Palettes.risk-deep(root.tier);
            y: (parent.height - 8px) / 2;
        }
        Text {
            text: Palettes.risk-up(root.tier);
            color: Palettes.risk-deep(root.tier);
            font-family: Theme.font-mono;
            font-size: 9.5px;
            font-weight: 600;
            letter-spacing: 0.8px;
            vertical-alignment: center;
        }
    }
}

// ---- data-class chip ----
export component DataChip inherits Rectangle {
    in property <string> cls;
    property <string> key: lower-first(cls);
    pure function lower-first(s: string) -> string {
        // map known classes to their first-segment key
        (s == "PUBLIC") ? "public" : (s == "CUI") ? "cui" : (s == "PHI") ? "phi"
        : (s == "ITAR") ? "itar"
        : (s == "FERPA" || s == "FERPA-directory" || s == "FERPA-restricted") ? "ferpa" : "public"
    }
    border-radius: Theme.r-pill;
    border-width: 1px;
    border-color: Palettes.dc-border(key);
    background: Palettes.dc-bg(key);
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        padding-top: 2px;
        padding-bottom: 2px;
        Text {
            text: root.cls;
            color: Palettes.dc-fg(root.key);
            font-family: Theme.font-mono;
            font-size: 9.5px;
            font-weight: root.key == "itar" ? 600 : 500;
            letter-spacing: 0.5px;
            vertical-alignment: center;
        }
    }
}

// ---- role glyph (square abbreviation; SO carries danger styling) ----
export component RoleGlyph inherits Rectangle {
    in property <string> role;
    in property <length> size: 22px;
    property <bool> danger: role == "SecurityOfficer";
    width: size;
    height: size;
    border-radius: 5px;
    border-width: 1px;
    border-color: danger ? Theme.danger : Theme.border-2;
    background: danger ? Theme.danger-bg : Theme.paper-2;
    Text {
        text: Palettes.role-abbr(root.role);
        color: root.danger ? Theme.danger : Theme.fg-2;
        font-family: Theme.font-mono;
        font-size: root.size * 0.4;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ---- signing-surface badge ----
export component SurfBadge inherits Rectangle {
    in property <string> surface;
    in property <color> fg: Theme.fg-3;
    in property <color> stroke: Theme.border-1;
    border-radius: 3px;
    border-width: 1px;
    border-color: stroke;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        padding-top: 1px;
        padding-bottom: 1px;
        Text {
            text: root.surface;
            color: root.fg;
            font-family: Theme.font-mono;
            font-size: 8.5px;
            letter-spacing: 0.5px;
            vertical-alignment: center;
        }
    }
}

// ---- severity dot ----
export component SevDot inherits Rectangle {
    in property <string> sev;
    width: 7px;
    height: 7px;
    border-radius: 3.5px;
    background: Palettes.sev-color(sev);
}

// ---- anchor mark (green ⚓ + strategy) ----
export component AnchorMark inherits HorizontalLayout {
    in property <string> strategy;
    spacing: 3px;
    AppIcon { name: "anchor"; size: 11px; tint: Theme.citrate-green; }
    Text {
        text: root.strategy;
        color: Theme.citrate-green;
        font-family: Theme.font-mono;
        font-size: 9px;
        vertical-alignment: center;
    }
}

// ---- keyframe diamond (Quorum gate) ----
// medium = hollow yellow · high = half-fill gold · critical = solid danger
export component Keyframe inherits Rectangle {
    in property <string> tier;   // medium | high | critical (auto/low render nothing)
    in property <bool> outlined: false;
    width: 13px;
    height: 13px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 13;
        viewbox-height: 13;
        commands: "M6.5 0 L13 6.5 L6.5 13 L0 6.5 Z";
        stroke-width: 1.5px;
        stroke: root.tier == "medium" ? Theme.risk-medium-deep
              : root.tier == "high" ? Theme.risk-high
              : root.tier == "critical" ? Theme.risk-critical-deep : transparent;
        fill: root.tier == "critical" ? (root.outlined ? transparent : Theme.danger)
            : root.tier == "high" ? (root.outlined ? transparent : Theme.risk-high.with-alpha(0.55))
            : transparent;
    }
}

// ---- hairline divider ----
export component Hairline inherits Rectangle {
    height: 1px;
    background: Theme.border-1;
}

// =============================================================
// Buttons
// =============================================================
export component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> kind: "ghost";       // primary | ghost | danger | ghost-dark
    in property <bool> sm: false;
    in property <bool> enabled: true;
    in property <length> icon-size: 13px;
    callback clicked;

    property <bool> primary: kind == "primary";
    property <bool> danger: kind == "danger";
    property <bool> ghost-dark: kind == "ghost-dark";

    height: sm ? 27px : 32px;
    border-radius: Theme.r-1;
    border-width: 1px;
    opacity: enabled ? 1.0 : 0.45;
    horizontal-stretch: 0;

    border-color: primary ? Theme.citrate-green
        : danger ? Theme.danger
        : ghost-dark ? Theme.sealed-border-2
        : (touch.has-hover ? Theme.ink : Theme.border-2);
    background: primary ? (touch.has-hover ? Theme.citrate-green-deep : Theme.citrate-green)
        : danger ? Theme.danger
        : ghost-dark ? (touch.has-hover ? Theme.sealed-tint-green : transparent)
        : transparent;
    animate background, border-color { duration: Theme.dur-fast; }

    HorizontalLayout {
        padding-left: root.sm ? 9px : 13px;
        padding-right: root.sm ? 9px : 13px;
        spacing: 7px;
        alignment: center;
        if root.icon != "": AppIcon {
            name: root.icon;
            size: root.icon-size;
            tint: root.primary ? (touch.has-hover ? #ffffff : Theme.ink)
                : root.danger ? #ffffff
                : root.ghost-dark ? Theme.sealed-fg : Theme.ink;
            y: (parent.height - self.height) / 2;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.primary ? (touch.has-hover ? #ffffff : Theme.ink)
                : root.danger ? #ffffff
                : root.ghost-dark ? Theme.sealed-fg : Theme.ink;
            font-family: Theme.font-sans;
            font-weight: 500;
            font-size: root.sm ? 11.5px : 12.5px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ---- icon-only button ----
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <length> size: 28px;
    in property <length> icon-size: 16px;
    in property <color> tint: Theme.fg-1;
    in property <bool> on-dark: false;
    in property <bool> enabled: true;
    callback clicked;
    width: size;
    height: size;
    border-radius: Theme.r-1;
    background: touch.has-hover ? (on-dark ? Theme.sealed-tint-green : #0000000f) : transparent;
    animate background { duration: Theme.dur-fast; }
    AppIcon {
        name: root.icon;
        size: root.icon-size;
        tint: root.tint;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ---- card (raised paper + hairline) ----
export component Card inherits Rectangle {
    in property <bool> lifted: false;
    background: Theme.paper-pure;
    border-radius: Theme.r-2;
    border-width: 1px;
    border-color: Theme.border-1;
    drop-shadow-color: lifted ? Theme.shadow-soft : transparent;
    drop-shadow-blur: lifted ? 28px : 0;
    drop-shadow-offset-y: lifted ? 10px : 0;
}
